# Host port that Cardboard listens on
PORT=8000

# Where the database and media files are stored on the host.
# Change this to an absolute path if you want data stored somewhere specific,
# e.g. /home/user/cardboard-data or /mnt/user/appdata/cardboard (Unraid).
DATA_PATH=./data

# CORS — restrict to your domain in production, e.g. https://cardboard.example.com
# Setting * exposes your data to any website you visit. Default is localhost only.
# ALLOWED_ORIGINS=https://cardboard.example.com

# Enable interactive API docs (Swagger UI at /api/docs, ReDoc at /redoc).
# Disabled by default to avoid exposing the API schema to unauthenticated users.
# ENABLE_DOCS=true

# Comma-separated list of trusted reverse-proxy IPs. When set, the app reads
# X-Forwarded-For from these peers to identify the real client IP (used by the
# BGG rate limiter). Without this, all requests behind a proxy share one bucket.
# Example: TRUSTED_PROXIES=10.0.0.1,172.16.0.1
# TRUSTED_PROXIES=

# How long to retain "Want to Play" visitor submissions (days).
# Older requests are automatically deleted when the owner views the requests list.
# Set to 0 to disable the retention sweep (keep forever). Default: 90
# WANT_TO_PLAY_RETENTION_DAYS=90
